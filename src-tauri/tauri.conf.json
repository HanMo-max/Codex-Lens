{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Lens",
  "version": "0.1.8",
  "identifier": "dev.codexlens.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Codex quota desktop widget and menu bar capsule",
    "longDescription": "A native Codex quota and model status monitor with an integrated macOS desktop widget and menu bar status capsule.",
    "copyright": "Copyright (c) 2026 Codex Lens contributors; includes work from Quota Float contributors",
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "CodexLens.entitlements",
      "infoPlist": "Info.plist"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
